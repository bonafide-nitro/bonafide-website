{
  "name": "bonafide-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bona Fide Nitro Coffee and Tea static site (Astro, static output only).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:dist": "node scripts/check-build-output.mjs",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:artifact": "node scripts/check-release-artifact.mjs",
    "package:preview": "node scripts/package-preview.mjs",
    "build:htaccess": "node scripts/build-htaccess.mjs",
    "check:htaccess": "node scripts/build-htaccess.mjs --check",
    "build:apache": "node scripts/build-apache-config.mjs",
    "check:apache": "node scripts/build-apache-config.mjs --check",
    "test": "node --test \"tests/foundation/*.test.mjs\" \"tests/qa/*.test.mjs\"",
    "test:build": "npm run build && npm run check:dist && npm run check:a11y && npm run check:links && npm run check:artifact && npm run qa:foundation",
    "qa": "node qa/cli.mjs --mode foundation",
    "qa:foundation": "node qa/cli.mjs --mode foundation",
    "qa:strict": "node qa/cli.mjs --mode strict",
    "intake:source": "node scripts/intake-source-evidence.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4"
  }
}
