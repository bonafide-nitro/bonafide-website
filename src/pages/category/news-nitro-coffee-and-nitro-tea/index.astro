---
import Base from '../../../layouts/Base.astro';
import ArchiveList from '../../../components/ArchiveList.astro';
import { PAGE1, CATEGORY } from '../../../lib/archive.mjs';
---
<!-- Tier-3 archive, complete against its baseline contract (static 200, self-canonical, indexable, sitemap, real pagination). Listing = exact live archive evidence (Issue #36 ZANETA_DECISION). The live <title>/meta description are not evidenced: the title is derived from the evidenced H1 (page 2 adds ' - Page 2' to satisfy the duplicate-title gate); no meta description is emitted. Excerpts/images are not evidenced and not invented. -->
<Base title="Category: News Nitro Coffee and Nitro Tea | Bona Fide Brewing Company" canonicalPath="/category/news-nitro-coffee-and-nitro-tea/" breadcrumbs={[{ name: 'Category: News Nitro Coffee and Nitro Tea', path: '/category/news-nitro-coffee-and-nitro-tea/' }]} fullBleed>
  <section class="band dark page-hero"><div class="wrap">
    <p class="eyebrow">News</p>
    <h1>Category: News Nitro Coffee and Nitro Tea</h1>
    <p>We are attentive to all what is happening in the market of Nitro Coffee and Nitro Tea.</p>
  </div></section>
  <section class="band tint"><div class="wrap">
  <ArchiveList posts={PAGE1} base={CATEGORY.base} current={1} />
  </div></section>
</Base>
