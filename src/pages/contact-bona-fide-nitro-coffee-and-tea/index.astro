---
import { commerceHref } from '../../lib/commerce.mjs';
import Base from '../../layouts/Base.astro';
import { resolveContactEndpoint } from '../../lib/contact-form.mjs';
// Provider endpoint is a public build-time value (see docs/migration/15-block11-contact-form-results.md).
const endpoint = resolveContactEndpoint(import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT);
---
<!-- scaffold: kept until the page meta description is preserved and a provider endpoint is configured. Structure and visible contact details are migrated from the public rendered evidence in Issue #30. The form posts only to the configured endpoint; with none configured it renders disabled and nothing is submitted anywhere. -->
<Base title="Contact - Bona Fide Nitro Coffee And Tea" canonicalPath="/contact-bona-fide-nitro-coffee-and-tea/" breadcrumbs={[{ name: 'Contact', path: '/contact-bona-fide-nitro-coffee-and-tea/' }]} fullBleed scaffold>
  <section class="hero page-hero"><img class="hero-bg" src="/wp-content/uploads/2018/06/Nitro-Coffeee-serving-from-tap-Bona-Fide.jpg" alt="" width="1920" height="1188" fetchpriority="high" decoding="async" />
  <div class="wrap">
  <p class="eyebrow">Get in touch</p>
  <h1>Contact</h1>
  <p>Reach Bona Fide for consumer, distributor, retailer and co-packer inquiries.</p>
  </div></section>
  <section><div class="wrap contact-grid">
  <div class="panel">
  <h2>Send us a message</h2>
  <p>Consumer, distributor, retailer and co-packer inquiries are all welcome. Please tell us which in your message.</p>
  <p>Please check your SPAM folder as well to find our responses. Thank you.</p>
  {!endpoint && (
    <p class="muted" role="status">The online form is not available yet. Please use the email address or phone number below.</p>
  )}
  <form method="post" action={endpoint ?? undefined} class="contact-form">
    <fieldset disabled={!endpoint}>
      <legend>Contact form</legend>
      <p>
        <label for="contact-name">Name</label><br />
        <input id="contact-name" name="name" type="text" autocomplete="name" required />
      </p>
      <p>
        <label for="contact-email">Email</label><br />
        <input id="contact-email" name="email" type="email" autocomplete="email" required />
      </p>
      <p>
        <label for="contact-message">Message</label><br />
        <textarea id="contact-message" name="message" rows="6" required></textarea>
      </p>
      <p class="hp" aria-hidden="true">
        <label for="contact-hp">Leave this field empty</label>
        <input id="contact-hp" name="bf_hp" type="text" tabindex="-1" autocomplete="off" />
      </p>
      <p><button type="submit" class="cta">Send message</button></p>
    </fieldset>
  </form>
  </div>
  <style is:global>
    .contact-form fieldset { border: 0; padding: 0; margin: 0; }
    .contact-form legend { position: absolute; left: -10000px; }
    .contact-form input[type="text"], .contact-form input[type="email"], .contact-form textarea { width: 100%; max-width: 32rem; font: inherit; padding: .4rem; }
    .contact-form .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
    .contact-form button { font: inherit; background: none; color: var(--accent); cursor: pointer; }
    .contact-form button:disabled { opacity: .5; cursor: not-allowed; }
  </style>

  <div class="side">
  <div class="panel dark">
  <h2>Bona Fide HQ</h2>
  <address>
    3020 Sherwin Ave Suite D<br />
    Ventura, CA 93003<br />
    <a href="tel:+18554821446">855-482-1446</a><br />
    <a href="mailto:contact@bonafidenitro.com">contact@bonafidenitro.com</a>
  </address>
  </div>

  <div class="panel">
  <h2>Webstore</h2>
  <p>If you are already set up and ready to pour our nitro products, you can buy PET or BIK Nitro Coffee and Nitro Tea kegs on our WebStore. We ship all over the USA.</p>
  <p><a class="btn btn-primary" href={commerceHref('webstore-root-www')}>Visit the Bona Fide webstore</a></p>
  </div>
  </div>
  </div></section>
  <section class="band tint"><div class="wrap center">
  <p>Not sure where to start? See <a href="/howtobuy/">How to Buy</a> or <a href="/nitro-coffee-questions/">Nitro Coffee Questions</a>.</p>
  </div></section>
</Base>
