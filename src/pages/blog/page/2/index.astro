---
import Base from '../../../../layouts/Base.astro';
import ArchiveList from '../../../../components/ArchiveList.astro';
import { PAGE2, BLOG } from '../../../../lib/archive.mjs';
---
<!-- Tier-3 archive, complete against its baseline contract (static 200, self-canonical, indexable, sitemap, real pagination). Listing = exact live archive evidence (Issue #36 ZANETA_DECISION). The live <title>/meta description are not evidenced: the page-2 title is the evidenced live title, byte-identical to /blog/ (ZANETA_DECISION; titleUniquenessException pair); no meta description is emitted. Excerpts/images are not evidenced and not invented. -->
<Base title="Nitro Coffee & Nitro Tea News | Bona Fide Brewing Company | Blog" canonicalPath="/blog/page/2/" breadcrumbs={[{ name: 'Blog', path: '/blog/' }, { name: 'Page 2', path: '/blog/page/2/' }]}>
  <h1>Nitro Coffee &amp; Nitro Tea News</h1>
  <ArchiveList posts={PAGE2} base={BLOG.base} current={2} />
</Base>
