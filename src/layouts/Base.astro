---
import { loadNavigation, loadSite } from '../lib/data.mjs';
import { commerceHref } from '../lib/commerce.mjs';
import { articleNodes } from '../lib/article-schema.mjs';
import GoogleTagManager from '../components/GoogleTagManager.astro';
const gtmId = import.meta.env.PUBLIC_GTM_ID; // public build-time config; unset/invalid => no GTM markup
// `scaffold` emits the QA marker: strict migration QA fails on it. Only pages that are
// NOT yet genuinely complete against their preservation contract may set it.
const { title, description, canonicalPath, breadcrumbs = [], scaffold = false, noindex = false, fullBleed = false } = Astro.props; // description: optional, emitted only when a page supplies evidenced text
const nav = loadNavigation();
const site = loadSite();
const abs = (p) => new URL(p, Astro.site).href;
const graph = [
  { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: `${site.url}/` },
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { '@id': `${site.url}/#organization` } },
];
if (canonicalPath) {
  graph.push({ '@type': 'WebPage', '@id': `${abs(canonicalPath)}#webpage`, url: abs(canonicalPath), name: title, isPartOf: { '@id': `${site.url}/#website` } });
  graph.push(...articleNodes(canonicalPath, site.url)); // Article + Person on historical posts only; [] elsewhere
  const crumbs = [{ name: 'Home', path: '/' }, ...breadcrumbs];
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.path) })),
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': canonicalPath ? graph : graph.slice(0, 2) });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {scaffold && <meta name="bonafide-qa" content="scaffold-placeholder" />} <!-- QA marker: strict migration QA fails on this -->
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalPath && <link rel="canonical" href={abs(canonicalPath)} />}
    <script type="application/ld+json" set:html={jsonLd} />
    <GoogleTagManager id={gtmId} position="head" />
    <style is:global>
      :root { --ink: #1c1712; --muted: #5b5147; --accent: #8a5a1f; --bg: #fffdf9; --card: #f6efe4; --gold: #e0a84a; --gold-ink: #2a1c08; --deep: #2b1d12; }
      * { box-sizing: border-box; }
      body { margin: 0; font: 16px/1.6 system-ui, sans-serif; color: var(--ink); background: var(--bg); }
      /* Header background is an implementation choice (the original markup does not evidence one): dark band so the white logo is readable. */
      header.main-header { background: var(--ink); border-bottom: 3px solid var(--gold); }
      header.main-header .site-branding { padding: .5rem 1rem; max-width: 76rem; margin: 0 auto; }
      header.main-header .site-logo { display: block; width: 250px; max-width: 100%; height: auto; }
      nav.site { background: var(--deep); }
      nav.site ul { display: flex; flex-wrap: wrap; gap: .1rem .25rem; list-style: none; margin: 0 auto; padding: .35rem .75rem; max-width: 76rem; }
      nav.site a { display: block; padding: .5rem .7rem; color: #f6efe4; text-decoration: none; border-radius: .3rem; font-size: .95rem; }
      nav.site a:hover, nav.site a:focus-visible { background: var(--gold); color: var(--gold-ink); }
      a { color: var(--accent); }
      main { max-width: 64rem; margin: 0 auto; padding: 1rem; }
      main.full { max-width: none; padding: 0; }
      .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; color: var(--muted); }
      .crumbs li + li::before { content: "/"; margin-right: .5rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1rem; padding: 0; list-style: none; }
      .card { background: var(--card); border-radius: .5rem; padding: 1rem; }
      .card h3 { margin-top: 0; }
      .card img { max-width: 100%; height: auto; }
      .page-media { margin: 1rem 0; text-align: center; }
      .page-media img { max-width: 100%; height: auto; }
      .cta img { width: 199px; max-width: 100%; height: auto; vertical-align: middle; }
      .cta { display: inline-block; margin: .25rem .5rem .25rem 0; padding: .4rem .8rem; border: 1px solid var(--accent); border-radius: .3rem; text-decoration: none; }
      .cta-label { color: var(--muted); border-style: dashed; }
      .price { font-weight: 700; }
      .muted { color: var(--muted); }
      footer.site-footer { background: var(--ink); color: #e9dfd0; border-top: 3px solid var(--gold); margin-top: 2rem; }
      footer.site-footer .in { max-width: 76rem; margin: 0 auto; padding: 1.75rem 1rem; display: grid; gap: 1.25rem; }
      footer.site-footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
      footer.site-footer a { color: #f3d9a4; display: inline-block; padding: .3rem 0; }
      footer.site-footer p { margin: 0; }
      /* Homepage (full-bleed) design. Colours: ink/deep brown, gold accent; no external fonts or scripts. */
      .wrap { max-width: 72rem; margin: 0 auto; padding: 3rem 1rem; }
      .center { text-align: center; }
      main.full h2 { font-size: clamp(1.6rem, 4.5vw, 2.4rem); line-height: 1.2; margin: 0 0 1rem; }
      main.full h3 { font-size: 1.4rem; margin: 1.25rem 0 .5rem; }
      main.full h4 { font-size: 1.05rem; margin: 1rem 0 .25rem; }
      .btn { display: inline-block; padding: .8rem 1.4rem; border-radius: .4rem; font-weight: 700; text-decoration: none; border: 2px solid transparent; margin: .25rem .5rem .25rem 0; min-height: 44px; }
      .btn-primary { background: var(--gold); color: var(--gold-ink); }
      .btn-primary:hover, .btn-primary:focus-visible { background: #f1c06b; }
      .btn-ghost { color: #fff; border-color: #fff; }
      .btn-ghost:hover, .btn-ghost:focus-visible { background: rgba(255,255,255,.15); }
      .btn-outline { color: var(--deep); border-color: var(--deep); }
      .btn-outline:hover, .btn-outline:focus-visible { background: var(--deep); color: #fff; }
      .hero { position: relative; color: #fff; background: #1c1712; overflow: hidden; isolation: isolate; }
      .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; z-index: -2; }
      .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(20,13,6,.93) 0%, rgba(20,13,6,.82) 50%, rgba(20,13,6,.45) 100%); }
      .hero-in { max-width: 72rem; margin: 0 auto; padding: 4rem 1rem 4.5rem; }
      .hero h1 { font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.1; margin: .25rem 0 1rem; max-width: 38rem; letter-spacing: .01em; }
      .eyebrow { color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: .12em; font-size: .85rem; margin: 0; }
      .lead { font-size: 1.15rem; max-width: 36rem; margin: 0 0 1.25rem; }
      .chips { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
      .chips li { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.35); border-radius: 999px; padding: .3rem .9rem; font-size: .9rem; }
      .band { padding: 0; }
      .band.quotes { background: var(--gold); color: var(--gold-ink); display: grid; gap: .5rem; padding: 1.25rem 1rem; text-align: center; }
      .band.quotes blockquote { margin: 0; font-weight: 700; font-size: 1.1rem; }
      .band.dark { background: var(--deep); color: #f6efe4; }
      .band.dark a.plain { color: #f3d9a4; }
      .band.tint { background: var(--card); }
      .intro { max-width: 52rem; text-align: center; }
      .path-grid { display: grid; gap: 1.5rem; }
      .path { background: #fff; border: 1px solid #e4d6bf; border-radius: .75rem; overflow: hidden; box-shadow: 0 6px 18px rgba(60,40,15,.1); display: flex; flex-direction: column; }
      .path img { width: 100%; height: 14rem; object-fit: contain; background: #f2e6d2; }
      .path-wholesale img { object-fit: cover; background: #8c6a45; }
      .path-body { padding: 1.25rem 1.5rem 1.5rem; }
      .path-body h3 { margin-top: .25rem; }
      .tag { display: inline-block; margin: 0; padding: .15rem .7rem; border-radius: 999px; background: var(--deep); color: #fff; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
      .split { display: grid; gap: 1.5rem; align-items: center; }
      .split img { width: 100%; height: auto; border-radius: .6rem; }
      .feature .split img { background: #fff; }
      .flavors { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .flavors li { background: #fff; border-radius: .6rem; padding: .5rem; text-align: center; }
      .flavors img { max-width: 100%; height: auto; }
      .channel-grid { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1rem; }
      .channel-grid li { background: #fff; border: 1px solid #e4d6bf; border-left: 6px solid var(--gold); border-radius: .5rem; padding: 1rem 1.25rem; font-weight: 600; }
      .cta-final .wrap { padding: 3.5rem 1rem; }
      @media (min-width: 48rem) {
        .path-grid { grid-template-columns: 1fr 1fr; }
        .split { grid-template-columns: 1fr 1fr; gap: 3rem; }
        .split.rev > img { order: 0; }
        .flavors { grid-template-columns: repeat(5, 1fr); }
        .channel-grid { grid-template-columns: repeat(4, 1fr); }
        .band.quotes { grid-template-columns: 1fr 1fr; }
        .hero-in { padding: 6rem 1rem 6.5rem; }
        footer.site-footer .in { grid-template-columns: 1fr 2fr; }
      }
      /* Inner pages (Phase 1 visual restoration). Presentation only; reuses the homepage palette, buttons and bands. */
      main.full .crumbs { max-width: 72rem; margin: 0 auto; padding: .6rem 1rem 0; font-size: .9rem; }
      main.full .crumbs ol { margin: 0; padding: 0; }
      .banner-full .page-media { margin: 0; text-align: initial; }
      .banner-full img { display: block; width: 100%; height: auto; max-height: 24rem; object-fit: cover; object-position: 50% 40%; }
      .page-hero { background: radial-gradient(ellipse at 85% 20%, rgba(224,168,74,.28) 0%, rgba(224,168,74,0) 55%), linear-gradient(135deg, #1c1712 0%, #2b1d12 60%, #4a3017 100%); color: #fff; border-bottom: 4px solid var(--gold); }
      .page-hero .wrap { padding: 2.75rem 1rem 3rem; }
      .page-hero h1 { font-size: clamp(2rem, 5.5vw, 3.2rem); line-height: 1.12; margin: .25rem 0 1rem; max-width: 46rem; letter-spacing: .01em; }
      .page-hero h2 { color: var(--gold); font-size: clamp(1.15rem, 3vw, 1.5rem); max-width: 46rem; }
      .page-hero p { max-width: 46rem; }
      .page-hero a:not(.btn) { color: #f3d9a4; }
      .page-hero.wholesale { background: linear-gradient(135deg, #14100b 0%, #24262b 55%, #3b3226 100%); }
      .page-hero .sep { font-size: 0; line-height: 0; margin: .5rem 0; }
      .page-hero .sep::before { content: ""; display: block; width: 3rem; height: 3px; background: var(--gold); }
      .prose > * { max-width: 48rem; }
      .prose h2, .prose h3 { margin-top: 1.5rem; }
      .band.dark h2, .band.dark h3 { color: #fff; }
      .band.dark h3, .band.dark h4 { color: var(--gold); }
      .band.dark p, .band.dark li { max-width: 48rem; }
      .band.dark a:not(.btn) { color: #f3d9a4; }
      .chips.light li { background: #fff; border-color: #e4d6bf; color: var(--deep); }
      .chips.gold li { background: rgba(224,168,74,.18); border-color: var(--gold); }
      .bullet-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin: 1rem 0; }
      .bullet-row .page-media { margin: 0; background: #fff; border-radius: .5rem; padding: .35rem; }
      .bullet-row .page-media img { height: 12rem; width: auto; display: block; }
      .bullet-row .chips { flex: 1 1 18rem; margin: 0; }
      .media-trio { display: grid; gap: 1rem; align-items: center; }
      .media-trio .page-media { margin: 0; }
      .media-trio img { border-radius: .6rem; background: #fff; }
      .media-trio > :not(:first-child) img { width: 100%; height: 28rem; object-fit: cover; }
      .product-grid { grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
      .product-grid .card { background: #fff; border: 1px solid #e4d6bf; border-radius: .75rem; box-shadow: 0 6px 18px rgba(60,40,15,.08); display: flex; flex-direction: column; padding: 1.1rem; }
      .product-grid .card h3 { font-size: 1.2rem; margin: 0 0 .75rem; color: var(--ink); }
      .product-grid .card img { align-self: center; width: auto; max-width: 100%; max-height: 15rem; object-fit: contain; background: var(--card); border-radius: .5rem; padding: .5rem; margin-bottom: .5rem; }
      .product-grid .card p { margin: .4rem 0; }
      .product-grid .card p:last-child { margin-top: auto; padding-top: .5rem; }
      .product-grid .price { color: var(--accent); font-size: 1.15rem; }
      .product-grid .cta { display: flex; flex-wrap: wrap; justify-content: center; text-align: center; align-items: center; gap: .25rem .5rem; min-height: 44px; margin: .25rem 0; padding: .55rem 1rem; background: var(--gold); color: var(--gold-ink); font-weight: 700; border: 2px solid transparent; border-radius: .4rem; }
      .product-grid .cta:hover, .product-grid .cta:focus-visible { background: #f1c06b; }
      .product-grid .cta:has(img) { background: #fff; color: var(--ink); border-color: #e4d6bf; }
      .product-grid .cta img { width: 130px; max-height: none; margin: 0; padding: 0; background: none; }
      .equip { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); align-items: end; max-width: 36rem; }
      .equip .page-media { margin: 0; background: #fff; border-radius: .6rem; padding: .5rem; }
      .checklist { list-style: none; padding: 0; margin: 1.25rem 0; display: grid; gap: .6rem; }
      .checklist li { color: var(--ink); position: relative; background: #fff; border: 1px solid #e4d6bf; border-radius: .5rem; padding: .6rem .9rem .6rem 2.4rem; }
      .checklist li::before { content: "\2713"; position: absolute; left: .85rem; top: .55rem; color: var(--accent); font-weight: 800; }
      .stat-row { display: grid; gap: 1rem; margin: 1.5rem 0; }
      .stat-row p { margin: 0; background: rgba(255,255,255,.08); border: 1px solid rgba(224,168,74,.55); border-left: 6px solid var(--gold); border-radius: .5rem; padding: 1rem 1.25rem; max-width: none; }
      .way-grid { display: grid; gap: 1.25rem; margin: 1.5rem 0; }
      .way { background: #fff; border: 1px solid #e4d6bf; border-top: 6px solid var(--gold); border-radius: .75rem; padding: 1.25rem 1.5rem; box-shadow: 0 6px 18px rgba(60,40,15,.08); }
      .way > :first-child { margin-top: 0; }
      .way .tag { margin-bottom: .5rem; }
      .partner-list { background: #fff; border: 1px solid #e4d6bf; border-radius: .75rem; padding: 1rem 1.25rem; }
      .values { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0; }
      .values p { margin: 0; background: #fff; border: 1px solid #e4d6bf; border-radius: 999px; padding: .35rem 1rem; font-weight: 600; }
      .fit-grid { display: grid; gap: 1rem; }
      .fit-grid ul { margin: 0; }
      .person { background: #fff; border: 1px solid #e4d6bf; border-radius: .75rem; padding: 1rem 1.25rem; box-shadow: 0 6px 18px rgba(60,40,15,.08); }
      .person h5 { font-size: 1.15rem; margin: 0 0 .25rem; }
      .person p { margin: 0; color: var(--muted); }
      .team-grid { display: grid; gap: 1rem; margin: 1rem 0; }
      .nitro-images { display: grid; gap: 1rem; margin: 1.5rem 0; }
      .nitro-images img { border-radius: .6rem; background: #fff; object-fit: cover; aspect-ratio: 4 / 3; width: 100%; }
      .topic-grid { display: grid; gap: 1rem; margin: 1.5rem 0; }
      .topic { background: #fff; border: 1px solid #e4d6bf; border-left: 6px solid var(--gold); border-radius: .6rem; padding: .25rem 1.25rem 1rem; }
      .topic h2 { font-size: 1.3rem; margin: .9rem 0 .4rem; }
      .topic p { margin: 0; }
      .contact-grid { display: grid; gap: 1.5rem; align-items: start; }
      .contact-grid .side { display: grid; gap: 1.5rem; }
      .panel { background: #fff; border: 1px solid #e4d6bf; border-radius: .75rem; padding: 1.25rem 1.5rem 1.5rem; box-shadow: 0 6px 18px rgba(60,40,15,.08); }
      .panel > :first-child { margin-top: 0; }
      .panel.dark { background: var(--deep); color: #f6efe4; border-color: var(--deep); }
      .panel.dark h2 { color: var(--gold); }
      .panel.dark a:not(.btn) { color: #f3d9a4; }
      .panel address { font-style: normal; line-height: 1.8; }
      .contact-form label { font-weight: 600; }
      .contact-form input[type="text"], .contact-form input[type="email"], .contact-form textarea { border: 1px solid #c9b79c; border-radius: .35rem; background: #fffdf9; padding: .6rem .7rem; }
      .contact-form button { background: var(--gold); color: var(--gold-ink); border: 2px solid transparent; border-radius: .4rem; font-weight: 700; padding: .8rem 1.4rem; min-height: 44px; }
      .contact-form button:disabled { background: #d9ccb8; color: var(--muted); }
      @media (min-width: 48rem) {
        .media-trio { grid-template-columns: 1fr 1fr; }
        .media-trio > :first-child { grid-column: 1 / -1; }
        .stat-row { grid-template-columns: repeat(3, 1fr); }
        .way-grid { grid-template-columns: repeat(2, 1fr); }
        .checklist { grid-template-columns: 1fr 1fr; }
        .fit-grid { grid-template-columns: 1fr 1fr; }
        .team-grid { grid-template-columns: repeat(2, 1fr); max-width: 40rem; }
        .nitro-images { grid-template-columns: repeat(3, 1fr); }
        .topic-grid { grid-template-columns: repeat(2, 1fr); }
        .contact-grid { grid-template-columns: 3fr 2fr; }
      }
      /* Phase 1 (Block 153): blog, articles, equipment, FAQ, archives and wholesale reuse the inner-page system above. Presentation only. */
      .page-hero .byline { color: #e9dfd0; margin: 0; }
      .page-hero .eyebrow + h1 { margin-top: .5rem; }
      .page-hero .byline time { color: #fff; }
      .article-body, .prose { font-size: 1.05rem; line-height: 1.75; }
      .article-body { padding-top: 2.5rem; padding-bottom: 3rem; }
      .article-body h2 { margin-top: 2rem; padding-bottom: .35rem; border-bottom: 3px solid var(--gold); display: inline-block; }
      .article-body h3, .prose h3 { margin-top: 1.5rem; color: var(--deep); }
      .article-body p, .article-body li { max-width: 46rem; }
      .prose img, .article-body img { max-width: 100%; height: auto; border-radius: .6rem; }
      .prose figure, .article-body figure { margin: 1.5rem 0; }
      .prose ul, .article-body ul { padding-left: 1.4rem; }
      .prose li + li { margin-top: .35rem; }
      .prose blockquote, .article-body blockquote { margin: 1.5rem 0; padding: .5rem 1.25rem; border-left: 6px solid var(--gold); background: var(--card); border-radius: .4rem; }
      .prose a, .article-body a { text-underline-offset: .15em; }
      .prose a.cta, .article-body a.cta { display: inline-block; min-height: 44px; background: var(--gold); color: var(--gold-ink); border: 2px solid transparent; border-radius: .4rem; padding: .7rem 1.2rem; font-weight: 700; text-decoration: none; }
      .prose a.cta:hover, .prose a.cta:focus-visible { background: #f1c06b; }
      .band.tint .wrap { padding-top: 2.5rem; padding-bottom: 3rem; }
      .equipment-images { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin: 1.5rem 0 2rem; max-width: none; align-items: center; }
      .equipment-images img { width: 100%; height: 15rem; object-fit: contain; background: #fff; border: 1px solid #e4d6bf; border-radius: .6rem; padding: .5rem; box-shadow: 0 6px 18px rgba(60,40,15,.08); }
      .post-grid { gap: 1.25rem; margin: 0 0 2rem; }
      .post-grid .card { position: relative; background: #fff; border: 1px solid #e4d6bf; border-top: 6px solid var(--gold); border-radius: .75rem; padding: 1.25rem 1.5rem; box-shadow: 0 6px 18px rgba(60,40,15,.08); }
      .post-grid .card:hover, .post-grid .card:focus-within { box-shadow: 0 10px 24px rgba(60,40,15,.18); }
      main.full .post-grid .card h2 { font-size: 1.2rem; line-height: 1.3; margin: 0 0 .6rem; }
      main.full .prose h2 { margin-top: 2.5rem; }
      .prose a.cta { margin-bottom: .5rem; }
      .post-grid .card h2 a { color: var(--ink); text-decoration: none; }
      .post-grid .card h2 a::after { content: ""; position: absolute; inset: 0; }
      .post-grid .card h2 a:hover, .post-grid .card h2 a:focus-visible { color: var(--accent); text-decoration: underline; }
      .post-grid .card p { margin: 0; }
      nav.pagination ol { list-style: none; display: flex; gap: .5rem; padding: 0; margin: 0; }
      nav.pagination a, nav.pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border-radius: .4rem; border: 2px solid var(--deep); font-weight: 700; text-decoration: none; color: var(--deep); background: #fff; }
      nav.pagination a:hover, nav.pagination a:focus-visible { background: var(--deep); color: #fff; }
      nav.pagination span[aria-current] { background: var(--gold); border-color: var(--gold); color: var(--gold-ink); }
      .page-hero.wholesale + .band .wrap > ul { background: #fff; border: 1px solid #e4d6bf; border-left: 6px solid var(--gold); border-radius: .5rem; padding: 1rem 1rem 1rem 2.4rem; max-width: 46rem; }
      .prose h4 { margin: 1.5rem 0 .25rem; padding-left: .75rem; border-left: 6px solid var(--gold); font-size: 1.1rem; }
      @media (max-width: 40rem) { .hero::before { background: rgba(20,13,6,.82); } }
    </style>
  </head>
  <body>
    <GoogleTagManager id={gtmId} position="body" />
    <header id="masthead" class="main-header header_layout_2 sticky-header sticky-scrolltop">
      <div class="site-branding">
        <a href="/" title="Bona Fide Nitro Coffee"><img src="/wp-content/uploads/2019/04/Bona-Fide-logo-White-color-big-tea-for-website-header-1.png" alt="Bona Fide Nitro Coffee" class="site-logo" width="250" height="108" /></a>
      </div>
    <nav class="site" aria-label="Main">
      <ul>
        {nav.launch.map((i) => <li><a href={i.path}>{i.label}</a></li>)}
        {nav.external.map((i) => <li><a href={commerceHref(i.commerceId)}>{i.label}</a></li>)}
      </ul>
    </nav>
    </header>
    <main class={fullBleed ? 'full' : undefined}>
      {canonicalPath && breadcrumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {breadcrumbs.map((c, i) => <li>{i === breadcrumbs.length - 1 ? c.name : <a href={c.path}>{c.name}</a>}</li>)}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="in">
        <p><strong>Bona Fide Nitro Coffee and Tea</strong><br />Nitrogen infused coffee and tea, brewed and kegged for coffee shops, offices, restaurants and homes.</p>
        <nav aria-label="Footer">
          <ul>
            {nav.launch.map((i) => <li><a href={i.path}>{i.label}</a></li>)}
            {nav.external.map((i) => <li><a href={commerceHref(i.commerceId)}>{i.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
