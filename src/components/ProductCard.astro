---
import fs from 'node:fs';
import { PAGE_MEDIA } from '../lib/page-media.mjs';
// One product card. `view` decides which facts render: retail shows Nitro/Still styles, the
// retail-only Amazon CTA label and retail price; wholesale shows the wholesale price only.
const { product: p, view } = Astro.props;
const name = view === 'wholesale' && p.wholesaleName ? p.wholesaleName : p.name;
const price = view === 'wholesale' ? p.pricing.wholesale : p.pricing.retail;
const store = p.links?.store && (p.links.storeViews ?? ['retail', 'wholesale']).includes(view) ? p.links.store : null;
const amazon = view === 'retail' ? Object.values(p.links?.amazon ?? {}) : [];
// Block 37: an image renders only when the product records original alt text AND the binary exists at the exact
// case-sensitive path under public/. Anything else stays text-only (never a missing or unevidenced image).
// Block 39: `alt` may be '' (the original page's observed empty alt); `viewOverrides` records original per-page differences.
const o = p.viewOverrides?.[view] ?? {};
const src = o.image ?? p.image;
const alt = o.alt ?? p.alt;
const image = src && typeof alt === 'string' && fs.existsSync(`public${src}`) ? src : null;
// Block 40: the original wraps the Amazon banner image inside every Amazon link.
const az = PAGE_MEDIA.amazon;
const azImage = fs.existsSync(`public${az.src}`);
// Issue #165: special-request SKUs have no store href; offer the existing contact page instead of a Buy button.
const contact = p.specialRequest && !store ? '/contact-bona-fide-nitro-coffee-and-tea/' : null;
const fmt = (n) => `$${n.toFixed(2)}`;
---
<li class="card">
  <h3>{name}</h3>
  {image && <img src={image} alt={alt} loading="lazy" decoding="async" />}
  <p class="muted">{p.nutrition}</p>
  <p>{p.description}</p>
  {p.specialRequest && <p><em>Special request</em></p>}
  {price != null && <p class="price">{fmt(price)} / {p.format}</p>}
  {price == null && p.format && <p>{p.format}</p>}
  {view === 'retail' && p.styles && <p>Nitro Style + Still (Flat) Style</p>}
  <p>
    {contact && <a class="cta" href={contact} aria-label={`Contact / Request availability for ${name}`}>Contact / Request availability</a>}
    {store && <a class="cta" href={store}>Buy on the Bona Fide webstore</a>}
    {amazon.map((href) => <a class="cta" href={href}>{azImage && <img src={az.src} alt={az.alt} width={az.width} height={az.height} loading="lazy" decoding="async" />} Buy Securely On Amazon.com</a>)}
  </p>
</li>
